<Application x:Class="ApiStudio.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApiStudio.Presentation.Converters"
             xmlns:local="clr-namespace:ApiStudio.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:IntToVisibilityConverter x:Key="IntToVis"/>
            <conv:IntToBooleanConverter x:Key="IntToBool"/>
            <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
            <conv:MethodToBrushConverter x:Key="MethodBrushConv"/>
            <conv:StatusToBrushConverter x:Key="StatusBrushConv"/>
            <conv:StringNullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
            <conv:BytesToStringConverter x:Key="BytesConv"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
