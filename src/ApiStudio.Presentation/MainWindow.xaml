<Window x:Class="ApiStudio.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ApiStudio.Presentation.Converters"
        xmlns:vm="clr-namespace:ApiStudio.Presentation.ViewModels"
        xmlns:enums="clr-namespace:ApiStudio.Domain.Enums;assembly=ApiStudio.Domain"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="ApiStudio - Modern API Testing" 
        Height="820" Width="1240"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <!-- Atmospheric Mesh Gradient for Frosted Glass Depth -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3F7FC" Offset="0.0" />
            <GradientStop Color="#E5EDF7" Offset="0.5" />
            <GradientStop Color="#DDE7F5" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:MethodToBrushConverter x:Key="MethodBrushConv"/>
        <conv:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <conv:BytesToStringConverter x:Key="BytesConv"/>

        <ObjectDataProvider x:Key="HttpMethods" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:HttpMethodType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="BodyTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BodyType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AuthTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AuthType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ApiKeyLocations" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ApiKeyLocation"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AssertionTargets" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AssertionTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AssertionOperators" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AssertionOperator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveActiveTabCommand}" />
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SelectedTab.SendCommand}" />
    </Window.InputBindings>

    <!-- Main Outer Container with Ambient Glass Lighting Orbs -->
    <Grid>
        <!-- Ambient Glass Light Glows in Background -->
        <Canvas IsHitTestVisible="False">
            <!-- Top-Right Accent Glow -->
            <Ellipse Width="450" Height="450" Canvas.Right="-80" Canvas.Top="-100">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#2400A3E0" Offset="0.0" />
                        <GradientStop Color="#0000A3E0" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Bottom-Left Deep Navy Glow -->
            <Ellipse Width="550" Height="550" Canvas.Left="-120" Canvas.Bottom="-150">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#1A00338D" Offset="0.0" />
                        <GradientStop Color="#0000338D" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Structure -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FROSTED GLASS HEADER BAR -->
            <Border Grid.Row="0" Margin="14,10,14,0" 
                    Background="{StaticResource GlassPanelGradient}" 
                    BorderBrush="{StaticResource GlassBorderGradient}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16,0"
                    Effect="{StaticResource GlassSubtleShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Glass Logo Pill -->
                        <Border Background="{StaticResource PrimaryBlueBrush}" CornerRadius="8" Padding="7" Margin="0,0,10,0" Effect="{StaticResource ButtonGlowBlue}">
                            <Path Data="{StaticResource IconSend}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="ApiStudio" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource GlassSubtleBrush}" BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Environment Selector Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="{StaticResource GlassSubtleBrush}" BorderBrush="{StaticResource GlassBorderGradient}" 
                            BorderThickness="1" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconEnvironment}" Fill="{StaticResource SecondaryTextBrush}" 
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Environment:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                            <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" 
                                      DisplayMemberPath="Name" Width="150" Height="28" VerticalContentAlignment="Center"/>
                            <Button Content="Manage" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2" Margin="8,0,0,0" Click="ManageEnvironments_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Quick Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="cURL Import" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,8,0" Command="{Binding ImportCurlCommand}"/>
                        <Button Content="Run Tests" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,8,0" Command="{Binding OpenRunnerCommand}"/>
                        <Button Style="{StaticResource IconButton}" Height="34" Width="34" ToolTip="Settings &amp; Theme" Command="{Binding OpenSettingsCommand}">
                            <Path Data="{StaticResource IconSettings}" Fill="{StaticResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="200" MaxWidth="500"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: FLOATING FROSTED GLASS CARD -->
                <Border Grid.Column="0" 
                        Background="{StaticResource GlassPanelGradient}" 
                        BorderBrush="{StaticResource GlassBorderGradient}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Effect="{StaticResource GlassCardShadow}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Segmented Navigation Pill Tabs -->
                        <Border Grid.Row="0" Background="{StaticResource GlassSubtleBrush}" BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Collections" 
                                             IsChecked="{Binding SelectedSidebarTab, Converter={StaticResource IntToBool}, ConverterParameter=0}"
                                             Style="{StaticResource SegmentedGlassRadio}"/>
                                <RadioButton Grid.Column="1" Content="History" 
                                             IsChecked="{Binding SelectedSidebarTab, Converter={StaticResource IntToBool}, ConverterParameter=1}"
                                             Style="{StaticResource SegmentedGlassRadio}"/>
                            </Grid>
                        </Border>

                        <!-- Search Filter Box with Glass Input -->
                        <Border Grid.Row="1" Margin="0,0,0,10">
                            <Grid>
                                <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="28,7,10,7" VerticalContentAlignment="Center"/>
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource SecondaryTextBrush}" 
                                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Content 1: Collections Tree View -->
                        <Grid Grid.Row="2" Visibility="{Binding SelectedSidebarTab, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                            <TreeView ItemsSource="{Binding CollectionNodes}" BorderThickness="0" Background="Transparent" Padding="2">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <!-- Method Pill Badge -->
                                            <Border Visibility="{Binding Method, Converter={StaticResource NullOrEmptyToVis}}" 
                                                    Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                                    CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnTreeViewItemDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>

                        <!-- Content 2: History List View -->
                        <Grid Grid.Row="2" Visibility="{Binding SelectedSidebarTab, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                            <ListView ItemsSource="{Binding HistoryItems}" BorderThickness="0" Background="Transparent" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="8,8" Cursor="Hand" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                                            CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="{StaticResource PrimaryTextBrush}" 
                                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusCode}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}" Margin="4,0,0,0"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding ExecutedAt, StringFormat='{}{0:HH:mm:ss} • {1} ms', TargetNullValue=''}" 
                                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Sidebar Footer Buttons -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ Collection" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding AddCollectionCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="Import" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding ImportCollectionCommand}" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- RIGHT WORKSPACE: TABS, REQUEST EDITOR & RESPONSE VIEWER -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Document Tabs Bar (Floating Glass Tabs) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tabs List -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GlassCardBrush}" 
                                                BorderBrush="{StaticResource GlassBorderGradient}" 
                                                BorderThickness="1" 
                                                CornerRadius="10" 
                                                Padding="12,6" 
                                                Margin="0,0,6,0" 
                                                Cursor="Hand"
                                                Effect="{StaticResource GlassSubtleShadow}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" 
                                                              Command="{Binding DataContext.NewTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding MethodString, Converter={StaticResource MethodBrushConv}}" 
                                                        CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding MethodString}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,8,0"/>
                                                <TextBlock Text="*" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" 
                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0"/>
                                                <Button Content="✕" Style="{StaticResource IconButton}" Padding="2" FontSize="10" 
                                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Add Tab (+) Button -->
                        <Button Grid.Column="1" Content="+" Style="{StaticResource SecondaryButton}" 
                                Width="36" Height="34" FontSize="16" FontWeight="Bold" Padding="0"
                                Command="{Binding NewTabCommand}" ToolTip="New Request (Ctrl+T)"/>
                    </Grid>

                    <!-- Active Tab Editor & Response Workspace -->
                    <Grid Grid.Row="1" DataContext="{Binding SelectedTab}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1. FLOATING URL BAR GLASS CAPSULE -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource GlassPanelGradient}" 
                                BorderBrush="{StaticResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10" 
                                Margin="0,0,0,8"
                                Effect="{StaticResource GlassSubtleShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <!-- Method Selector -->
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Source={StaticResource HttpMethods}}" 
                                          SelectedItem="{Binding Method}" Height="38" FontWeight="Bold" 
                                          VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                                <!-- URL Input Box -->
                                <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="38" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Send / Cancel Button -->
                                <Grid Grid.Column="2" Margin="0,0,10,0">
                                    <Button Style="{StaticResource PrimaryButton}" Height="38" 
                                            Command="{Binding SendCommand}" 
                                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSend}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Send" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Height="38" 
                                            Command="{Binding CancelCommand}" 
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCancel}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Cancel" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Save Button -->
                                <Button Grid.Column="3" Content="Save" Style="{StaticResource SecondaryButton}" Height="38" 
                                        Command="{Binding SaveCommand}"/>
                            </Grid>
                        </Border>

                        <!-- 2. REQUEST CONFIGURATION TABS (FROSTED GLASS CARD) -->
                        <Border Grid.Row="1" 
                                Background="{StaticResource GlassPanelGradient}" 
                                BorderBrush="{StaticResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="14,10" 
                                Effect="{StaticResource GlassCardShadow}">
                            <TabControl Style="{StaticResource ModernTabControl}">
                                <!-- PARAMS TAB -->
                                <TabItem Header="Params">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid Grid.Row="0" ItemsSource="{Binding QueryParams}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                                                  Background="Transparent" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                <DataGridTemplateColumn Width="45">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" 
                                                                    Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="1" Content="+ Add Parameter" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding AddQueryParamCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </Grid>
                                </TabItem>

                                <!-- HEADERS TAB -->
                                <TabItem Header="Headers">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid Grid.Row="0" ItemsSource="{Binding Headers}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                                                  Background="Transparent" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                <DataGridTemplateColumn Width="45">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" 
                                                                    Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="1" Content="+ Add Header" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding AddHeaderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </Grid>
                                </TabItem>

                                <!-- AUTHORIZATION TAB -->
                                <TabItem Header="Authorization">
                                    <StackPanel Margin="0,14,0,0" MaxWidth="600" HorizontalAlignment="Left">
                                        <TextBlock Text="Authorization Type" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource AuthTypes}}" 
                                                  SelectedItem="{Binding SelectedAuthType}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                        <!-- Bearer Token Fields -->
                                        <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:AuthType.Bearer}}">
                                            <TextBlock Text="Bearer Token" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                        </StackPanel>

                                        <!-- Basic Auth Fields -->
                                        <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:AuthType.Basic}}">
                                            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12"/>
                                            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                        </StackPanel>

                                        <!-- API Key Fields -->
                                        <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:AuthType.ApiKey}}">
                                            <TextBlock Text="Key Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12"/>
                                            <TextBlock Text="Key Value" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12"/>
                                            <TextBlock Text="Add to" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource ApiKeyLocations}}" 
                                                      SelectedItem="{Binding ApiKeyLocation}" Width="200" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <!-- BODY TAB -->
                                <TabItem Header="Body">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Body Type Selector -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Content Type:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource BodyTypes}}" 
                                                      SelectedItem="{Binding SelectedBodyType}" Width="160" VerticalContentAlignment="Center"/>
                                            <Button Content="Format JSON" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding FormatJsonCommand}" Margin="12,0,0,0"
                                                    Visibility="{Binding SelectedBodyType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:BodyType.Json}}"/>
                                        </StackPanel>

                                        <!-- Raw Body Editor (JSON, XML, Text) -->
                                        <TextBox Grid.Row="1" Style="{StaticResource CodeTextBox}" 
                                                 Text="{Binding RawBodyContent, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding SelectedBodyType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:BodyType.Json}}"/>

                                        <!-- Form-URL-Encoded DataGrid -->
                                        <Grid Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:BodyType.FormUrlEncoded}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DataGrid Grid.Row="0" ItemsSource="{Binding UrlEncodedParams}" AutoGenerateColumns="False" 
                                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                      BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="50"/>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                                    <DataGridTemplateColumn Width="45">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Grid.Row="1" Content="+ Add Field" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding AddUrlEncodedParamCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        </Grid>

                                        <!-- Multipart Form Data DataGrid -->
                                        <Grid Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:BodyType.MultipartFormData}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DataGrid Grid.Row="0" ItemsSource="{Binding FormDataParams}" AutoGenerateColumns="False" 
                                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                      BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="50"/>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                                    <DataGridTemplateColumn Width="45">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Grid.Row="1" Content="+ Add Form Field" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding AddFormDataParamCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        </Grid>

                                        <!-- Binary File Selector -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0"
                                                    Visibility="{Binding SelectedBodyType, Converter={StaticResource BoolToVis}, ConverterParameter={x:Static enums:BodyType.BinaryFile}}">
                                            <Button Content="Select File..." Style="{StaticResource SecondaryButton}" Command="{Binding SelectFileCommand}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding BinaryFilePath, TargetNullValue='No file selected'}" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- TESTS & ASSERTIONS TAB -->
                                <TabItem Header="Tests">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid Grid.Row="0" ItemsSource="{Binding Assertions}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="50"/>
                                                <DataGridComboBoxColumn Header="Target" SelectedItemBinding="{Binding Target}" 
                                                                        ItemsSource="{Binding Source={StaticResource AssertionTargets}}" Width="150"/>
                                                <DataGridTextColumn Header="Property / Path" Binding="{Binding PropertyName}" Width="150"/>
                                                <DataGridComboBoxColumn Header="Operator" SelectedItemBinding="{Binding Operator}" 
                                                                        ItemsSource="{Binding Source={StaticResource AssertionOperators}}" Width="120"/>
                                                <DataGridTextColumn Header="Expected Value" Binding="{Binding ExpectedValue}" Width="*"/>
                                                <DataGridTemplateColumn Width="45">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="1" Content="+ Add Assertion" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding AddAssertionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!-- 3. SLICK GLASS SPLITTER WITH PILL HANDLE -->
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

                        <!-- 4. RESPONSE VIEWER: FLOATING FROSTED GLASS CARD -->
                        <Border Grid.Row="3" 
                                Background="{StaticResource GlassPanelGradient}" 
                                BorderBrush="{StaticResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="16,12" 
                                Effect="{StaticResource GlassCardShadow}">
                            <Grid DataContext="{Binding Response}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Response Status Metrics & Action Bar -->
                                <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Translucent Glowing Status Metrics Badges -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Glowing Status Pill -->
                                            <Border Background="{StaticResource SuccessPillBgBrush}" 
                                                    BorderBrush="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="10,4" 
                                                    Margin="0,0,10,0"
                                                    Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontWeight="Bold" FontSize="12" 
                                                           Foreground="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}">
                                                    <Run Text="{Binding StatusCode, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding StatusDescription, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>

                                            <!-- Time Pill -->
                                            <Border Background="{StaticResource GlassSubtleBrush}" 
                                                    BorderBrush="{StaticResource GlassBorderGradient}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="8,4" 
                                                    Margin="0,0,10,0"
                                                    Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" 
                                                           FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>

                                            <!-- Size Pill -->
                                            <Border Background="{StaticResource GlassSubtleBrush}" 
                                                    BorderBrush="{StaticResource GlassBorderGradient}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="8,4"
                                                    Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ContentSizeBytes, Converter={StaticResource BytesConv}}" 
                                                           FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Copy" Style="{StaticResource SecondaryButton}" Height="30" 
                                                    Command="{Binding CopyBodyCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Save to File" Style="{StaticResource SecondaryButton}" Height="30" 
                                                    Command="{Binding SaveToFileCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Response Inspection Tabs -->
                                <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}" Margin="0,6,0,0">
                                    <!-- PRETTY BODY -->
                                    <TabItem Header="Pretty">
                                        <TextBox Style="{StaticResource CodeTextBox}" Text="{Binding FormattedBody, Mode=OneWay}" 
                                                 IsReadOnly="True" Margin="0,6,0,0"/>
                                    </TabItem>

                                    <!-- RAW BODY -->
                                    <TabItem Header="Raw">
                                        <TextBox Style="{StaticResource CodeTextBox}" Text="{Binding Body, Mode=OneWay}" 
                                                 IsReadOnly="True" Margin="0,6,0,0"/>
                                    </TabItem>

                                    <!-- HEADERS -->
                                    <TabItem Header="Headers">
                                        <DataGrid ItemsSource="{Binding Headers}" AutoGenerateColumns="False" 
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                                                  Background="Transparent" Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="250" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <!-- COOKIES -->
                                    <TabItem Header="Cookies">
                                        <ListView ItemsSource="{Binding Cookies}" BorderThickness="1" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" Background="Transparent" Margin="0,6,0,0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Code, Consolas, monospace" Padding="4,6"/>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </TabItem>

                                    <!-- TEST RESULTS -->
                                    <TabItem Header="Test Results">
                                        <ListView ItemsSource="{Binding TestResults}" BorderThickness="1" 
                                                  BorderBrush="{StaticResource GlassBorderGradient}" Background="Transparent" Margin="0,6,0,0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left"
                                                                    Background="{Binding Passed, Converter={StaticResource BoolToVis}, ConverterParameter={StaticResource SuccessBrush}}">
                                                                <TextBlock Text="PASSED" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
