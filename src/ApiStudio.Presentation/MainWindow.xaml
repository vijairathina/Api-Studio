<Window x:Class="ApiStudio.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ApiStudio.Presentation.Converters"
        xmlns:vm="clr-namespace:ApiStudio.Presentation.ViewModels"
        xmlns:enums="clr-namespace:ApiStudio.Domain.Enums;assembly=ApiStudio.Domain"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="ApiStudio - v2.4.1" 
        Height="840" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_icon.png"
        Background="{DynamicResource WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      CornerRadius="14" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:MethodToBrushConverter x:Key="MethodBrushConv"/>
        <conv:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <conv:BytesToStringConverter x:Key="BytesConv"/>

        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ObjectDataProvider x:Key="HttpMethods" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:HttpMethodType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="BodyTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BodyType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AuthTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AuthType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ApiKeyLocations" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ApiKeyLocation"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AssertionTargets" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AssertionTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AssertionOperators" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AssertionOperator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveActiveTabCommand}" />
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SelectedTab.SendCommand}" />
    </Window.InputBindings>

    <!-- Main Outer Container with Ambient Glass Lighting Orbs -->
    <Grid>
        <!-- Ambient Glass Light Glows in Background (glowing neon cyan and cobalt orbs visible through transparent panels) -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="650" Height="650" Canvas.Right="-80" Canvas.Top="-120" Fill="{DynamicResource AmbientGlow1Brush}"/>
            <Ellipse Width="750" Height="750" Canvas.Left="-140" Canvas.Bottom="-160" Fill="{DynamicResource AmbientGlow2Brush}"/>
            <Ellipse Width="500" Height="500" Canvas.Right="120" Canvas.Bottom="-90" Fill="{DynamicResource AmbientGlow3Brush}"/>
        </Canvas>

        <!-- Main Structure -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP INTEGRATED WINDOW BAR (preview.png match) -->
            <Grid Grid.Row="0" Margin="16,6,16,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand: Icon + ApiStudio - v2.4.1 -->
                    <ColumnDefinition Width="*"/>    <!-- Center Title / Draggable Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Actions & Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- Brand: Squircle App Icon + ApiStudio - v2.4.1 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Margin="0,0,10,0" Width="24" Height="24" Effect="{DynamicResource ButtonGlowBlue}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,24,24"/>
                        </Border.Clip>
                        <Image Source="Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="ApiStudio" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" - v2.4.1" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Center Drag Area -->
                <Grid Grid.Column="1" Background="Transparent"/>

                <!-- Right Quick Actions & Window Caption Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="cURL Import" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="0,0,6,0" Command="{Binding ImportCurlCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Run Tests" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="0,0,10,0" Command="{Binding OpenRunnerCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button Style="{StaticResource WindowCaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource WindowCaptionButton}" Click="Maximize_Click" ToolTip="Maximize / Restore">
                        <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. MAIN WORKSPACE WITH ACTIVITY RAIL, TWO-CARD SIDEBAR, AND EDITOR -->
            <Grid Grid.Row="1" Margin="14,6,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>  <!-- Left Activity Rail -->
                    <ColumnDefinition Width="280" MinWidth="220" MaxWidth="450"/> <!-- Sidebar (Collections + History) -->
                    <ColumnDefinition Width="8"/>   <!-- Splitter -->
                    <ColumnDefinition Width="*"/>   <!-- Right Editor Workspace -->
                </Grid.ColumnDefinitions>

                <!-- LEFT ACTIVITY RAIL -->
                <Border Grid.Column="0" Margin="0,0,8,0" 
                        Background="{DynamicResource GlassPanelGradient}" 
                        BorderBrush="{DynamicResource GlassBorderGradient}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="0,12"
                        Effect="{DynamicResource GlassCardShadow}">
                    <Grid>
                        <!-- Top Navigation Items -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <!-- Menu Button -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,0,10" ToolTip="Menu">
                                <Path Data="{StaticResource IconMenu}" Fill="{DynamicResource SecondaryTextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>

                            <!-- Collections (Active Pill) -->
                            <Border Background="#1A00D2FF" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="8" Width="34" Height="34" Margin="0,0,0,10">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="API Collections">
                                    <Path Data="{StaticResource IconGrid}" Fill="#00D2FF" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                            </Border>

                            <!-- Environments Button -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,0,10" ToolTip="Manage Environments" Click="ManageEnvironments_Click">
                                <Path Data="{StaticResource IconEnvironment}" Fill="{DynamicResource SecondaryTextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>

                            <!-- Runner Button -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,0,10" ToolTip="Batch Collection Runner" Command="{Binding OpenRunnerCommand}">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource SecondaryTextBrush}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Bottom Rail Tools -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            <!-- History Icon -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,0,8" ToolTip="History">
                                <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource SecondaryTextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>

                            <!-- Notifications Bell -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,0,8" ToolTip="Notifications">
                                <Path Data="{StaticResource IconBell}" Fill="{DynamicResource SecondaryTextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>

                            <!-- Settings Gear -->
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" ToolTip="Settings &amp; Theme" Command="{Binding OpenSettingsCommand}">
                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource SecondaryTextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SIDEBAR: TWO DISTINCT FROSTED GLASS CARDS (Collections + History) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="180"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="2*" MinHeight="130"/>
                    </Grid.RowDefinitions>

                    <!-- CARD A: API Collections -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource GlassPanelGradient}" 
                            BorderBrush="{DynamicResource GlassBorderGradient}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="12,10"
                            Effect="{DynamicResource GlassCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Card Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="API Collections" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Add Collection" Command="{Binding AddCollectionCommand}">
                                        <Path Data="{StaticResource IconAdd}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Import Collection" Command="{Binding ImportCollectionCommand}" Margin="2,0,0,0">
                                        <Path Data="{StaticResource IconImport}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="More Options" Margin="2,0,0,0">
                                        <Path Data="{StaticResource IconMore}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Search Filter Input -->
                            <Border Grid.Row="1" Margin="0,0,0,8">
                                <Grid>
                                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="26,6,8,6" VerticalContentAlignment="Center" FontSize="12"/>
                                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource SecondaryTextBrush}" 
                                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Collections Tree -->
                            <TreeView Grid.Row="2" ItemsSource="{Binding CollectionNodes}" BorderThickness="0" Background="Transparent" Padding="0">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,3">
                                            <Border Visibility="{Binding Method, Converter={StaticResource NullOrEmptyToVis}}" 
                                                    Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                                    CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnTreeViewItemDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- Splitter between Cards -->
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

                    <!-- CARD B: Request History -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource GlassPanelGradient}" 
                            BorderBrush="{DynamicResource GlassBorderGradient}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="12,10"
                            Effect="{DynamicResource GlassCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Card Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Request History" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Clear History" Command="{Binding ClearHistoryCommand}">
                                        <Path Data="{StaticResource IconDelete}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="More Options" Margin="2,0,0,0">
                                        <Path Data="{StaticResource IconMore}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- History List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding HistoryItems}" BorderThickness="0" Background="Transparent" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="6,6" Cursor="Hand" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                                        CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="{DynamicResource PrimaryTextBrush}" 
                                                           FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusCode}" FontWeight="Bold" FontSize="11"
                                                           Foreground="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Vertical Splitter between Sidebar and Workspace -->
                <GridSplitter Grid.Column="2" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- 3. RIGHT WORKSPACE: TABS, UNIFIED URL CAPSULE, CONFIG & RESPONSE -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Document Tabs -->
                        <RowDefinition Height="*"/>    <!-- Active Tab Workspace -->
                    </Grid.RowDefinitions>

                    <!-- Document Tabs Bar matching preview.png -->
                    <Grid Grid.Row="0" Margin="0,0,0,8" Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <!-- Tabs Scroll Area -->
                            <ColumnDefinition Width="Auto"/> <!-- Scroll Left/Right arrows + Split View tools -->
                        </Grid.ColumnDefinitions>

                        <!-- Tabs Scroll Area -->
                        <ScrollViewer x:Name="TabsScrollViewer" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnTabsScrollViewerPreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tabs ItemsControl -->
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,0" Height="32" Cursor="Hand" MouseLeftButtonUp="OnTabItemClick" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#172338"/>
                                                        <Setter Property="BorderBrush" Value="#2C3E5B"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                        <Setter Property="Padding" Value="11,0,8,0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#22334F"/>
                                                                <Setter Property="BorderBrush" Value="#4D38BDF8"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#294877" Offset="0.0"/>
                                                                            <GradientStop Color="#142646" Offset="1.0"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="BorderBrush" Value="#00D2FF"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="16" Color="#00D2FF" Opacity="0.6" ShadowDepth="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" 
                                                                  Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tab Name Text (High-contrast, crystal-clear visibility) -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                               FontSize="12" FontWeight="SemiBold" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Method Badge -->
                                                    <Border Grid.Column="1" 
                                                            Background="{Binding MethodString, Converter={StaticResource MethodBrushConv}}" 
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.85"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding MethodString}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Dirty indicator * -->
                                                    <TextBlock Grid.Column="2" Text="*" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" FontSize="12"
                                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" VerticalAlignment="Center"/>

                                                    <!-- Close Button ✕ -->
                                                    <Button Grid.Column="3" Content="✕" Width="20" Height="20" Padding="0" FontSize="10" 
                                                            VerticalAlignment="Center" Cursor="Hand" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" ToolTip="Close tab">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                      TextElement.Foreground="#94A3B8"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- Active Tab Glowing Accent Indicator (Bottom Bar) -->
                                                    <Border Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="2.5" CornerRadius="1.5"
                                                            Background="#00D2FF" Margin="4,0,4,-1">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" Color="#00D2FF" Opacity="0.9" ShadowDepth="0"/>
                                                        </Border.Effect>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Tab (+) Button directly next to last tab (preview.png match) -->
                                <Button Width="30" Height="30" Margin="2,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                        Command="{Binding NewTabCommand}" ToolTip="New Request (Ctrl+T)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Width="28" Height="28" CornerRadius="6" 
                                                    Background="#260F1A2D" BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1">
                                                <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#4D152542"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00D2FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Side Tools: Tab Scroll Arrows, Split View, More (preview.png match) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                            <!-- Scroll Left Button -->
                            <Button Width="24" Height="28" Margin="0,0,2,0" Style="{StaticResource IconButton}" 
                                    Click="ScrollTabsLeft_Click" ToolTip="Scroll Tabs Left">
                                <Path Data="M 6,0 L 0,5 L 6,10" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="7" Height="10" Stretch="Uniform"/>
                            </Button>
                            <!-- Scroll Right Button -->
                            <Button Width="24" Height="28" Margin="0,0,6,0" Style="{StaticResource IconButton}" 
                                    Click="ScrollTabsRight_Click" ToolTip="Scroll Tabs Right">
                                <Path Data="M 0,0 L 6,5 L 0,10" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="7" Height="10" Stretch="Uniform"/>
                            </Button>
                            <!-- Split View Button -->
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,2,0" ToolTip="Split View">
                                <Path Data="{StaticResource IconSplit}" Fill="{DynamicResource SecondaryTextBrush}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <!-- More Options Button -->
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="More Options">
                                <Path Data="{StaticResource IconMore}" Fill="{DynamicResource SecondaryTextBrush}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Active Tab Workspace -->
                    <Grid Grid.Row="1" DataContext="{Binding SelectedTab}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Unified URL Capsule -->
                            <RowDefinition Height="*"/>    <!-- Sub-tabs (Params, Headers, etc.) -->
                            <RowDefinition Height="6"/>    <!-- Splitter -->
                            <RowDefinition Height="*"/>    <!-- Response Card -->
                        </Grid.RowDefinitions>

                        <!-- 1. UNIFIED URL BAR GLASS CAPSULE (Exact match to preview.png) -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource GlassPanelGradient}" 
                                BorderBrush="{DynamicResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="8,6" 
                                Margin="0,0,0,8"
                                Effect="{DynamicResource GlassSubtleShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Globe Icon -->
                                    <ColumnDefinition Width="*"/>    <!-- URL Box -->
                                    <ColumnDefinition Width="Auto"/> <!-- Environment Pill -->
                                    <ColumnDefinition Width="Auto"/> <!-- Method Pill -->
                                    <ColumnDefinition Width="Auto"/> <!-- Send Button -->
                                </Grid.ColumnDefinitions>

                                <!-- Globe Icon -->
                                <Path Grid.Column="0" Data="{StaticResource IconGlobe}" Fill="{DynamicResource SecondaryTextBrush}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="8,0,10,0" VerticalAlignment="Center"/>

                                <!-- URL Input Box -->
                                <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" Height="36" FontSize="13" 
                                         VerticalContentAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Environment Selector Pill -->
                                <Border Grid.Column="2" Background="{DynamicResource GlassSubtleBrush}" BorderBrush="{DynamicResource GlassBorderGradient}" 
                                        BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding DataContext.Environments, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding DataContext.SelectedEnvironment, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              DisplayMemberPath="Name" MinWidth="130" Height="28" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>

                                <!-- Method Selector Pill -->
                                <Border Grid.Column="3" Background="{DynamicResource GlassSubtleBrush}" BorderBrush="{DynamicResource GlassBorderGradient}" 
                                        BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding Source={StaticResource HttpMethods}}" 
                                              SelectedItem="{Binding Method}" MinWidth="85" Height="28" FontWeight="Bold" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>

                                <!-- Send / Cancel Button -->
                                <Grid Grid.Column="4">
                                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0" 
                                            Command="{Binding SendCommand}" 
                                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSend}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Send" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <Path Data="{StaticResource IconFastForward}" Fill="#80FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Height="36" Padding="18,0" 
                                            Command="{Binding CancelCommand}" 
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCancel}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Cancel" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. REQUEST CONFIGURATION TABS (FROSTED GLASS CARD) -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource GlassPanelGradient}" 
                                BorderBrush="{DynamicResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="14,10" 
                                Effect="{DynamicResource GlassCardShadow}">
                            <TabControl Style="{StaticResource ModernTabControl}">
                                <!-- PARAMS TAB -->
                                <TabItem Header="Request parameters">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+ Add Parameter" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding AddQueryParamCommand}"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding QueryParams}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                <DataGridTemplateColumn Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- HEADERS TAB -->
                                <TabItem Header="Headers">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+ Add Header" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding AddHeaderCommand}"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding Headers}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                <DataGridTemplateColumn Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- AUTH TAB -->
                                <TabItem Header="Authorization">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,0" MaxWidth="600" HorizontalAlignment="Left">
                                            <TextBlock Text="Authorization Type" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource AuthTypes}}" 
                                                      SelectedItem="{Binding SelectedAuthType}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                            <!-- Bearer Token -->
                                            <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Bearer}">
                                                <TextBlock Text="Bearer Token" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Basic Auth -->
                                            <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Basic}">
                                                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- API Key -->
                                            <StackPanel Visibility="{Binding SelectedAuthType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ApiKey}">
                                                <TextBlock Text="Key Name" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="Key Value" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="Add To" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource ApiKeyLocations}}" 
                                                          SelectedItem="{Binding ApiKeyLocation}" Width="150" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- BODY TAB -->
                                <TabItem Header="Body">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Body Format Selector Bar -->
                                        <Border Grid.Row="0" Background="{DynamicResource GlassSubtleBrush}" 
                                                BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" 
                                                CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Quick Body Format Pill Buttons -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Format:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                                    <Button Content="none" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="None"/>
                                                    <Button Content="JSON" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="Json"/>
                                                    <Button Content="XML" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="Xml"/>
                                                    <Button Content="Text" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="Text"/>
                                                    <Button Content="form-data" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="MultipartFormData"/>
                                                    <Button Content="x-www-form-urlencoded" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,4,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="FormUrlEncoded"/>
                                                    <Button Content="binary" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="BinaryFile"/>
                                                </StackPanel>

                                                <!-- Current Selected Dropdown -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource BodyTypes}}" 
                                                              SelectedItem="{Binding SelectedBodyType}" Width="150" Height="26" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 1. EMPTY STATE (When None is selected) -->
                                        <Border Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=None}"
                                                Background="{DynamicResource GlassSubtleBrush}" BorderBrush="{DynamicResource GlassBorderGradient}" 
                                                BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                                                <TextBlock Text="This request does not have a body" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="To send data with your request, choose a body type above or click one of the quick options below:" 
                                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                                <WrapPanel HorizontalAlignment="Center">
                                                    <Button Content="+ Create JSON Body" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Margin="4" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="Json"/>
                                                    <Button Content="+ Add Form Data" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="4" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="MultipartFormData"/>
                                                    <Button Content="+ Add URL-Encoded" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="4" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="FormUrlEncoded"/>
                                                    <Button Content="+ Attach Binary File" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="4" 
                                                            Command="{Binding SetBodyTypeCommand}" CommandParameter="BinaryFile"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. RAW TEXT / JSON / XML EDITOR -->
                                        <Grid Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Json|Xml|Text}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Editor Sub-Toolbar -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1A00D2FF" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SelectedBodyType, StringFormat='{}Content-Type: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                                                    </Border>
                                                    <Button Content="Format JSON" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,6,0" 
                                                            Command="{Binding FormatJsonCommand}" ToolTip="Beautify JSON indentation"/>
                                                    <Button Content="Preset: {}" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,6,0" 
                                                            Command="{Binding InsertEmptyJsonObjectCommand}" ToolTip="Insert empty JSON object"/>
                                                    <Button Content="Preset: []" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,6,0" 
                                                            Command="{Binding InsertEmptyJsonArrayCommand}" ToolTip="Insert empty JSON array"/>
                                                    <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" 
                                                            Command="{Binding ClearBodyCommand}" ToolTip="Clear body content"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Code Editor TextBox -->
                                            <TextBox Grid.Row="1" Style="{StaticResource CodeTextBox}" 
                                                     Text="{Binding RawBodyContent, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="180" VerticalAlignment="Stretch"/>
                                        </Grid>

                                        <!-- 3. MULTIPART FORM DATA TABLE -->
                                        <Grid Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MultipartFormData}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="+ Add Form Field" Style="{StaticResource SecondaryButton}" 
                                                        Command="{Binding AddFormDataParamCommand}" Height="26" Padding="10,0"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FormDataParams}" AutoGenerateColumns="False" 
                                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                      BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                    <DataGridTemplateColumn Width="50">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- 4. URL ENCODED TABLE -->
                                        <Grid Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FormUrlEncoded}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="+ Add Parameter" Style="{StaticResource SecondaryButton}" 
                                                        Command="{Binding AddUrlEncodedParamCommand}" Height="26" Padding="10,0"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding UrlEncodedParams}" AutoGenerateColumns="False" 
                                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                      BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                                    <DataGridTemplateColumn Width="50">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- 5. BINARY FILE PICKER -->
                                        <Border Grid.Row="1" Visibility="{Binding SelectedBodyType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BinaryFile}"
                                                Background="{DynamicResource GlassSubtleBrush}" BorderBrush="{DynamicResource GlassBorderGradient}" 
                                                BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                                                <TextBlock Text="Select a Binary File to Send" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <Button Content="Choose File to Upload..." Style="{StaticResource PrimaryButton}" Command="{Binding SelectFileCommand}" Height="34" Padding="18,0" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding BinaryFilePath, TargetNullValue='No file selected'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- TESTS TAB -->
                                <TabItem Header="Tests">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+ Add Assertion" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding AddAssertionCommand}"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding Assertions}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridComboBoxColumn Header="Target" SelectedItemBinding="{Binding Target}" 
                                                                        ItemsSource="{Binding Source={StaticResource AssertionTargets}}" Width="140"/>
                                                <DataGridTextColumn Header="Property" Binding="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                                <DataGridComboBoxColumn Header="Operator" SelectedItemBinding="{Binding Operator}" 
                                                                        ItemsSource="{Binding Source={StaticResource AssertionOperators}}" Width="120"/>
                                                <DataGridTextColumn Header="Expected Value" Binding="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTemplateColumn Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!-- Splitter between Config and Response -->
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

                        <!-- 3. RESPONSE VIEWER: FLOATING FROSTED GLASS CARD (exact match to preview.png) -->
                        <Border Grid.Row="3" 
                                Background="{DynamicResource GlassPanelGradient}" 
                                BorderBrush="{DynamicResource GlassBorderGradient}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="16,12" 
                                Effect="{DynamicResource GlassCardShadow}">
                            <Grid DataContext="{Binding Response}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Response Metrics Header Bar -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title "Response" -->
                                        <TextBlock Grid.Column="0" Text="Response" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                                        <!-- Glowing Metrics Badges (Status Code, Response Time, Size) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <!-- Status Code Pill -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Status Code: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#1E10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#10B981" Opacity="0.35" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <TextBlock FontWeight="Bold" FontSize="11" Foreground="#10B981">
                                                        <Run Text="{Binding StatusCode, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding StatusDescription, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <!-- Response Time Pill -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Response Time: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#1E00D2FF" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#00D2FF" Opacity="0.35" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" 
                                                               FontWeight="Bold" FontSize="11" Foreground="#00D2FF"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Size Pill -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Size: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#1E38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.35" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="{Binding ContentSizeBytes, Converter={StaticResource BytesConv}}" 
                                                               FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions (Copy, Save) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Copy" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Command="{Binding CopyBodyCommand}" Margin="0,0,6,0"/>
                                            <Button Content="Save to File" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Command="{Binding SaveToFileCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Response Inspection Tabs -->
                                <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}" Margin="0,6,0,0">
                                    <!-- PRETTY TAB -->
                                    <TabItem Header="Pretty">
                                        <TextBox Style="{StaticResource CodeTextBox}" Text="{Binding FormattedBody, Mode=OneWay}" 
                                                 IsReadOnly="True" Margin="0,6,0,0"/>
                                    </TabItem>

                                    <!-- RAW TAB -->
                                    <TabItem Header="Raw">
                                        <TextBox Style="{StaticResource CodeTextBox}" Text="{Binding Body, Mode=OneWay}" 
                                                 IsReadOnly="True" Margin="0,6,0,0"/>
                                    </TabItem>

                                    <!-- HEADERS TAB -->
                                    <TabItem Header="Headers">
                                        <DataGrid ItemsSource="{Binding Headers}" AutoGenerateColumns="False" 
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="1" 
                                                  Background="Transparent" Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <!-- TEST RESULTS TAB -->
                                    <TabItem Header="Test Results">
                                        <ListView ItemsSource="{Binding TestResults}" BorderThickness="0" Background="Transparent" Margin="0,6,0,0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{Binding Passed, Converter={StaticResource StatusBrushConv}}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Passed, Converter={StaticResource StatusBrushConv}}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
