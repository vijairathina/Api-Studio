<Window x:Class="ApiStudio.Presentation.Views.Controls.CollectionRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ApiStudio.Presentation.Converters"
        Title="Collection Test Runner - ApiStudio" 
        Height="620" Width="880"
        WindowStartupLocation="CenterOwner">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3F7FC" Offset="0.0" />
            <GradientStop Color="#E5EDF7" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <conv:MethodToBrushConverter x:Key="MethodBrushConv"/>
        <conv:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Collection Test Runner" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding SelectedCollection.Name, StringFormat='Active Suite: {0}'}" 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Run Collection" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" 
                        Width="140" Height="38" Margin="0,0,10,0"/>
                <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Width="85" Height="38"/>
            </StackPanel>
        </Grid>

        <!-- Summary Metrics Card (Frosted Glass Container) -->
        <Border Grid.Row="1" Background="{StaticResource GlassPanelGradient}" 
                BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                CornerRadius="12" Padding="18" Margin="0,0,0,16" Effect="{StaticResource GlassCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL REQUESTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalRequests}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="PASSED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="{Binding PassedRequests}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="FAILED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock Text="{Binding FailedRequests}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="DURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalElapsedMs, StringFormat='{}{0} ms'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detailed Results List (Frosted Glass Card) -->
        <Border Grid.Row="2" Background="{StaticResource GlassPanelGradient}" 
                BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                CornerRadius="12" Padding="10" Effect="{StaticResource GlassCardShadow}">
            <ListView ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- Method Pill Badge -->
                                <Border Grid.Column="0" Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                        CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                </Border>

                                <!-- Status Code -->
                                <TextBlock Grid.Column="1" Text="{Binding StatusCode}" FontWeight="Bold" 
                                           Foreground="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}" 
                                           VerticalAlignment="Center"/>

                                <!-- Request Name -->
                                <TextBlock Grid.Column="2" Text="{Binding RequestName}" FontWeight="SemiBold" 
                                           Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" 
                                           VerticalAlignment="Center" Margin="8,0"/>

                                <!-- URL -->
                                <TextBlock Grid.Column="3" Text="{Binding Url}" Foreground="{StaticResource SecondaryTextBrush}" 
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <!-- Elapsed Time -->
                                <TextBlock Grid.Column="4" Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" 
                                           Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Medium" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right"/>

                                <!-- Pass/Fail Result Pill -->
                                <Border Grid.Column="5" Margin="10,0,0,0" Padding="8,3" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{StaticResource SuccessPillBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1">
                                    <TextBlock Text="PASSED" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer / Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" 
                   FontSize="12" FontWeight="Medium" Margin="0,12,0,0"/>
    </Grid>
</Window>
