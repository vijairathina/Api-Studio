<Window x:Class="ApiStudio.Presentation.Views.Controls.CollectionRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ApiStudio.Presentation.Converters"
        Title="Collection Runner - ApiStudio" 
        Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBackgroundBrush}">

    <Window.Resources>
        <conv:MethodToBrushConverter x:Key="MethodBrushConv"/>
        <conv:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Collection Test Runner" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding SelectedCollection.Name, StringFormat='Running: {0}'}" 
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Run Collection" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" 
                        Width="130" Margin="0,0,10,0"/>
                <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Width="80"/>
            </StackPanel>
        </Grid>

        <!-- Summary Metrics Card -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalRequests}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="PASSED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="{Binding PassedRequests}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="FAILED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock Text="{Binding FailedRequests}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalElapsedMs, StringFormat='{}{0} ms'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detailed Results List -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                CornerRadius="6" Padding="8">
            <ListView ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Method Badge -->
                                <Border Grid.Column="0" Background="{Binding Method, Converter={StaticResource MethodBrushConv}}" 
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Method}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                </Border>

                                <!-- Status Code -->
                                <TextBlock Grid.Column="1" Text="{Binding StatusCode}" FontWeight="SemiBold" 
                                           Foreground="{Binding StatusCode, Converter={StaticResource StatusBrushConv}}" 
                                           VerticalAlignment="Center"/>

                                <!-- Request Name -->
                                <TextBlock Grid.Column="2" Text="{Binding RequestName}" FontWeight="Medium" 
                                           Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" 
                                           VerticalAlignment="Center" Margin="8,0"/>

                                <!-- URL -->
                                <TextBlock Grid.Column="3" Text="{Binding Url}" Foreground="{StaticResource SecondaryTextBrush}" 
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <!-- Elapsed Time -->
                                <TextBlock Grid.Column="4" Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" 
                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right"/>

                                <!-- Pass/Fail Result -->
                                <Border Grid.Column="5" Margin="8,0,0,0" Padding="6,2" CornerRadius="3" HorizontalAlignment="Center">
                                    <TextBlock Text="PASSED" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer / Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" 
                   FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</Window>
