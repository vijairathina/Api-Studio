<Window x:Class="ApiStudio.Presentation.Views.Controls.EnvironmentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Environments - ApiStudio" 
        Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Environments &amp; Variables" FontSize="20" FontWeight="SemiBold" 
                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Environment List -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" 
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Padding="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="1" Content="+ Add Environment" Style="{StaticResource SecondaryButton}" 
                            Click="AddEnvironment_Click" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Variables Editor for Selected Environment -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid DataContext="{Binding SelectedEnvironment}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Name & Active -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" FontWeight="SemiBold"/>
                        <CheckBox Grid.Column="1" Content="Set Active" IsChecked="{Binding IsActive}" 
                                  VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Variables (use in requests as {{variableName}})" 
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <!-- Variables Grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Variables}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                              Background="Transparent" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="50"/>
                            <DataGridTextColumn Header="Variable" Binding="{Binding Key}" Width="150"/>
                            <DataGridTextColumn Header="Initial / Current Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Secret" Binding="{Binding IsSecret}" Width="60"/>
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Style="{StaticResource IconButton}" 
                                                Command="{Binding DeleteCommand}" Foreground="{StaticResource ErrorBrush}" 
                                                ToolTip="Delete variable"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3" Content="+ Add Variable" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding AddVariableCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="90" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
