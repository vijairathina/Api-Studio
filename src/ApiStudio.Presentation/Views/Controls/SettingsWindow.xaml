<Window x:Class="ApiStudio.Presentation.Views.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - ApiStudio" 
        Height="540" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3F7FC" Offset="0.0" />
            <GradientStop Color="#E5EDF7" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings &amp; Preferences" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="Customize application theme, networking behavior, and stored data." 
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Body (Frosted Glass Container) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Section 1: Appearance & Theme -->
                <Border Background="{StaticResource GlassPanelGradient}" 
                        BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,14" Effect="{StaticResource GlassCardShadow}">
                    <StackPanel>
                        <TextBlock Text="Appearance &amp; Theme" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Choose the visual theme for the frosted glass interface:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Light Glass Option -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource GlassCardBrush}" 
                                    BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <RadioButton Content="Light Glass" GroupName="ThemeGroup" 
                                                 FontWeight="SemiBold" FontSize="13"
                                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Light}"/>
                                    <TextBlock Text="Crisp translucent white with signature corporate blue highlights" 
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="20,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Dark Glass Option -->
                            <Border Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource GlassCardBrush}" 
                                    BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <RadioButton Content="Dark Glass" GroupName="ThemeGroup" 
                                                 FontWeight="SemiBold" FontSize="13"
                                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dark}"/>
                                    <TextBlock Text="Deep navy frosted acrylic with glowing cyan and blue accents" 
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="20,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Request & Network Defaults -->
                <Border Background="{StaticResource GlassPanelGradient}" 
                        BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,14" Effect="{StaticResource GlassCardShadow}">
                    <StackPanel>
                        <TextBlock Text="Request Defaults" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Default Request Timeout (seconds)" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Maximum time allowed for HTTP request execution before timeout" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="Automatically follow HTTP redirects" IsChecked="{Binding FollowRedirects}" FontWeight="Medium" Margin="0,0,0,10"/>
                        <CheckBox Content="Verify TLS / SSL certificates" IsChecked="{Binding VerifySsl}" FontWeight="Medium" Margin="0,0,0,10"/>
                        <CheckBox Content="Auto-format JSON response payloads" IsChecked="{Binding AutoFormatJson}" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Section 3: Data Management -->
                <Border Background="{StaticResource GlassPanelGradient}" 
                        BorderBrush="{StaticResource GlassBorderGradient}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Effect="{StaticResource GlassCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Local History Storage" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding HistoryCount, StringFormat='Currently storing {0} requests in sanitized local history.'}" 
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear History" Style="{StaticResource DangerButton}" 
                                Command="{Binding ClearHistoryCommand}" Height="34" Padding="14,4"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" 
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save &amp; Close" Style="{StaticResource PrimaryButton}" 
                        Command="{Binding SaveCommand}" Width="130" Height="38"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
